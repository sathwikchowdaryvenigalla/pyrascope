# Backend (read by backend/config.py via python-dotenv)
GEE_PROJECT_ID=your-google-cloud-project-id
# Optional service-account auth for servers (key file must live OUTSIDE the repo):
# GEE_SERVICE_ACCOUNT=
# GEE_PRIVATE_KEY_FILE=
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite only exposes variables prefixed with VITE_)
# Single API base URL used by every request. No trailing slash needed.
VITE_API_BASE_URL=http://localhost:8000
